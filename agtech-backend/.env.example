# Copy this file to agtech-backend/.env and fill the credentials delivered by Primary.
REMARKETS_USER=
REMARKETS_PASSWORD=
REMARKETS_ACCOUNT=

# La base de datos por defecto es H2 en memoria; no hace falta configurar nada.
# Solo si activás el perfil "postgres", descomentá y ajustá estas variables:
