# Copy this file to agtech-backend/.env and fill the credentials delivered by Primary.
REMARKETS_USER=
REMARKETS_PASSWORD=
REMARKETS_ACCOUNT=

# La base de datos por defecto es MySQL. Ajustá estas variables si usás otros
# valores (por ejemplo, en producción):
# DB_URL=jdbc:mysql://localhost:3306/presec_trensolar?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root

# Para usar H2 en memoria (sin instalar MySQL), activá el perfil "h2":
# SPRING_PROFILES_ACTIVE=h2
