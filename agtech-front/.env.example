# PuroGrano · frontend
# Copiá este archivo a .env y ajustá los valores según el entorno.

# true = inferencia y guardado simulados localmente (default)
VITE_USE_MOCK=true

# Servicio de inferencia (FastAPI)
VITE_ANALYSIS_API_URL=http://localhost:8000
VITE_PREDICT_PATH=/predict

# Backend de persistencia (Spring Boot)
VITE_BACKEND_API_URL=http://localhost:8081
VITE_SAVE_ANALYSIS_PATH=/api/v1/analyses

# Snapshot de mercado del backend (Matba Rofex + DolarAPI)
VITE_MARKET_API_URL=http://localhost:8081/api/market-snapshot

# URL pública de la escena de Spline. Vacío = escena isométrica SVG local.
VITE_SPLINE_SCENE_URL=
